{
  "name": "dust-wave-opportunity-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare-based HEY, Zoho, and Creative West opportunity ingestion for Dust Wave.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run docs:check && npm run typecheck && npm run test:coverage && npm run deploy:dry",
    "backfill:hey": "node scripts/hey-backfill.mjs",
    "cf-typegen": "wrangler types --env-file .env.example",
    "deploy": "node scripts/deploy.ts",
    "deploy:email-routing": "wrangler deploy",
    "deploy:dry": "node scripts/deploy.ts --dry-run",
    "dev": "wrangler dev --test-scheduled",
    "docs:check": "node scripts/check-docs.mjs",
    "migrate:local": "wrangler d1 migrations apply dustwave-opportunity-radar --local",
    "migrate:remote": "wrangler d1 migrations apply dustwave-opportunity-radar --remote",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "wrangler types --env-file .env.example --check && tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "postal-mime": "^3.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsonc-parser": "^3.3.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260820.1": true
  }
}
