# Copy to .dev.vars for local development. Never commit real credentials.
ADMIN_TOKEN=replace-with-a-random-token

# Enable after creating the Notion connection and sharing Opportunities with it.
NOTION_TOKEN=

# Enable after completing the Zoho OAuth setup.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Private newsletter source IDs, helpEmail, and optional name aliases; see docs/NEWSLETTER.md.
NEWSLETTER_SETTINGS=

# Development-only live classifier/Jev evaluation. Optional with one-account Wrangler login.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
